# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# AI Model for Academy Assistant (Defaults to gemini-3.8-flash)
AI_MODEL="gemini-3.8-flash"

# Port (Defaults to 3000 for AI Studio environment)
PORT=3000

# MongoDB URI (Optional: e.g. mongodb://localhost:27017/academy or mongodb+srv://...)
# If not provided, an in-memory data store with full seed data is automatically utilized.
MONGO_URI=""

# JWT Secret for authentication tokens
JWT_SECRET="academy_jwt_secret_key_2026_super_secure"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

